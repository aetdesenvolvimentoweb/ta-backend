{
  "name": "ta-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:unit": "bun test --filter '\\.test\\.ts$'",
    "test:integration": "bun test --filter integration",
    "test:e2e": "bun test --filter e2e",
    "test:coverage": "bun test --coverage",
    "test:staged": "bun test $(git diff --staged --name-only | grep '\\.test\\.ts$')",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:test": "bun --env-file=.env.test drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "postgres": "^3.4.9"
  }
}
