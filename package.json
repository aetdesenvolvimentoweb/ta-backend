{
  "name": "ta-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:unit": "bun test --filter '\\.test\\.ts$'",
    "test:integration": "bun test --filter '\\.itest\\.ts$'",
    "test:e2e": "bun test --filter '\\.e2e\\.ts$'",
    "test:coverage": "bun test --coverage",
    "test:staged": "bun test $(git diff --staged --name-only | grep '\\.test\\.ts$')"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.28"
  }
}
