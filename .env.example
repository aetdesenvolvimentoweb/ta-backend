DATABASE_URL=postgres://user:password@localhost:5432/ta_dev
NODE_ENV=development
PORT=3000

# Segurança — mínimo 32 caracteres cada
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# CORS: "*" em dev; em prod, lista comma-separated de origins
CORS_ORIGIN=*

# Rate limit (RN13)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Admin (RN12) — lista comma-separated de e-mails autorizados
ADMIN_WHITELIST=admin@toqueaquela.app

# Logs
LOG_LEVEL=info

# Criptografia AES-256-GCM dos tokens OAuth de pagamento (RN17/22).
# Gere com: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).reduce((s,b)=>s+b.toString(16).padStart(2,'0'),''))"
PAYMENT_TOKEN_KEY=

# Mercado Pago — OAuth Connect (RN14).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/v1/payment-accounts/callback
MP_FRONTEND_RETURN_URL=http://localhost:5173/artista/perfil

# Segredo HMAC para validar webhooks do Mercado Pago (Entrega B).
# Obtenha no painel de webhooks: Configurações → Webhooks → Secret key
MP_WEBHOOK_SECRET=

# Base URL pública do frontend — usada para montar as back_urls do Checkout Pro.
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173

# Restringe o Checkout Pro a PIX apenas. true em produção (menor taxa, UX fricção-zero).
# Em dev/teste com vendedor sintético do MP, definir false.
MP_PIX_ONLY=true

# Em dev com test users do MP: usar sandbox_init_point. false em produção.
MP_USE_SANDBOX_CHECKOUT=false
